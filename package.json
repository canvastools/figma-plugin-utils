{
  "name": "figma-plugin-utils",
  "version": "2.0.0",
  "description": "Helpers for working with the Figma node tree from a plugin sandbox.",
  "keywords": [
    "figma"
  ],
  "author": "Canvas Tools",
  "license": "MIT",
  "homepage": "https://github.com/canvastools/figma-plugin-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canvastools/figma-plugin-utils.git"
  },
  "bugs": {
    "url": "https://github.com/canvastools/figma-plugin-utils/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "*",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint . || true",
    "lint:ci": "tsc --noEmit && eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prod": "vite build && npm run lint"
  }
}
