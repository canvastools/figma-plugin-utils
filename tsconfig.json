{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    // Sandbox-only helpers — no DOM, which also avoids the `console` / `fetch`
    // clash between lib.dom and @figma/plugin-typings
    "lib": ["es2020"],

    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,

    "rootDir": "./src",
    "removeComments": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["@figma/plugin-typings"],

    "noEmit": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.d.ts"]
}
